{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "card:item/magical_athlete/token/romantic"
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "card:item/magical_athlete/hand/romantic"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "card:item/magical_athlete/hand/back"
    }
  }
}
